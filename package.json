{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "packages/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/survivor-616",
    "build": "npm run build --workspace=@workspace/survivor-616 && mkdir -p dist && cp -r artifacts/survivor-616/dist/public/* dist/",
    "typecheck": "npm run typecheck --workspace=@workspace/survivor-616",
    "lint": "npm run typecheck"
  },
  "overrides": {
    "esbuild": "0.27.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3"
  }
}
