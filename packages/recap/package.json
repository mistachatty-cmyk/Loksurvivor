{
  "name": "@lok/recap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/adapter.ts",
  "types": "src/adapter.ts",
  "exports": {
    ".": "./src/adapter.ts",
    "./schema": "./src/schema.ts",
    "./poster": "./src/poster/drawPosterCard.ts"
  },
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts RunRecapVertical out/recap.mp4",
    "render:wide": "remotion render src/index.ts RunRecapWide out/recap-wide.mp4",
    "still": "remotion still src/index.ts RunRecapVertical out/recap-card.png --frame=180",
    "typecheck": "tsc --noEmit",
    "postinstall": "remotion browser ensure",
    "render:run": "node scripts/render-run.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.240",
    "remotion": "4.0.240",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "typescript": "^5.5.4"
  }
}
