    ".": "./src/index.ts",
    "./template": "./src/template.ts",
    "./react": "./src/react/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\""
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "react": "19.1.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "react-dom": "19.1.0",
    "@types/react-dom": "^19.2.0"
